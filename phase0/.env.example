# Match the LinkedIn account owner's real device
ACCOUNT_TIMEZONE=America/Chicago
CHROME_LANG=en-US

# Long random string. Live View URL: http://localhost:8090/?token=<this>
LIVEVIEW_TOKEN=change-me-to-a-long-random-string

# Leave empty to go out through the server's own public IP.
# Plain proxy:           PROXY_SERVER=http://203.0.113.20:3128
# Proxy with user/pass:  PROXY_SERVER=http://proxy-gateway:8080  (+ run with --profile proxy)
PROXY_SERVER=
UPSTREAM_PROXY_URL=

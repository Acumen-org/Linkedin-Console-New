# ---- Site ----
# Public domain (automatic HTTPS):   SITE_ADDRESS=app.example.com
# LAN / testing over plain HTTP:      SITE_ADDRESS=:80   and COOKIE_SECURE=false
SITE_ADDRESS=app.example.com
COOKIE_SECURE=true
HTTP_PORT=80
HTTPS_PORT=443
# Behind a gateway (APISIX, nginx…): its IP/CIDR, space-separated, so real client IPs are used
# for the login throttle and the audit log. Leave empty when clients connect to Caddy directly.
TRUSTED_PROXIES=

# ---- Secrets (install.sh fills these in) ----
POSTGRES_PASSWORD=
POD_AGENT_TOKEN=
LIVE_SECRET=
REDIS_PASSWORD=

# ---- Company sign-in: Microsoft 365 (optional, recommended) ----
# An app registration in Microsoft Entra ID (the same tenant as the Twilio console):
#   redirect URI (Web):  <APP_URL>/api/auth/microsoft/callback     (APP_URL below must be set)
#   API permissions:     Microsoft Graph → openid, profile, email (delegated)
# Only teammates already added here can sign in; MFA and access policies come from Microsoft.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Who may still use a password: on (everyone) | owner (only the owner, for emergencies)
PASSWORD_SIGNIN=on

# ---- Twilio console staff list (optional) ----
# Follows the Twilio console's staff list: leavers (resigned/archived there) are disabled and signed
# out here. off | disable | provision (also adds active staff as members with no account access;
# needs Microsoft sign-in). The key is the Twilio console's SERVER_API_KEY.
TWILIO_CONSOLE_URL=https://h00ks.acm.acumen-strategy.com
TWILIO_CONSOLE_API_KEY=
STAFF_SYNC=off
STAFF_SYNC_MINUTES=5

# ---- Defaults for new LinkedIn accounts ----
DEFAULT_TIMEZONE=America/Chicago
DEFAULT_LANGUAGE=en-US
# Access teammates (MEMBER role) get automatically on new accounts and as new users:
# NONE (recommended: admins grant per account) | READ | REPLY | FULL
DEFAULT_GRANT=NONE
# Max messages sent per LinkedIn account per day (all teammates combined)
DAILY_SEND_CAP=80

# ---- Email alerts (optional) ----
# Emails the owner/admins when an account needs re-login or its browser goes offline.
SMTP_URL=
ALERT_FROM=LinkedIn Console <alerts@yourcompany.com>
# Public URL used in alert links, e.g. https://inbox.yourcompany.com
APP_URL=

# ---- Account pods ----
POD_MEMORY_MB=2048
# Unload an account's human-facing tabs after this many minutes without Live View viewers
# (connected accounts only; restored when someone opens Live View). Syncing is unaffected.
PARK_AFTER_MINUTES=10
# fast: a text reply reaches LinkedIn in about half a second (LinkedIn's own send request).
# human: typed into the page with human pauses, several seconds per message.
SEND_MODE=fast
# Extra env for the sidecar, comma separated, e.g. CAPTURE_RAW=1
SIDECAR_ENV=

# ---- AI reply drafts (optional) ----
# Suggests a reply in the composer; a human always reviews and sends it.
#   anthropic → Claude API (the recent messages of that conversation are sent to Anthropic)
#   ollama    → local model on your server
AI_PROVIDER=
# Defaults: claude-opus-5-5 (anthropic) / qwen2.5:7b (ollama)
AI_MODEL=

# ---- Push notifications ----
# Contact for the push service (keys are generated automatically)
VAPID_SUBJECT=mailto:admin@yourcompany.com

# ---- Self-healing (optional) ----
# When LinkedIn changes a button, ask an AI model to find it again (result is cached).
#   anthropic → Claude API (needs ANTHROPIC_API_KEY; page text is sent to Anthropic when healing)
#   ollama    → local model, fully self-hosted (run Ollama somewhere reachable, e.g. OLLAMA_URL=http://10.10.10.30:11434)
HEAL_PROVIDER=
# Defaults: claude-opus-5-5 (anthropic) / qwen2.5:7b (ollama)
HEAL_MODEL=

# Shared by AI drafts and self-healing
ANTHROPIC_API_KEY=
OLLAMA_URL=
